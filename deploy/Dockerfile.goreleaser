# syntax=docker/dockerfile:1
FROM alpine:3.21

ARG TARGETPLATFORM

# ffmpeg encodes the alert audio to Opus RTP, so it must be in the image.
# curl is how the command TTS provider reaches an HTTP model server, and is
# the only thing that can URL-encode an alert sentence: busybox wget cannot.
RUN apk add --no-cache ca-certificates tzdata ffmpeg curl \
    && addgroup -S tgpager \
    && adduser -S tgpager -G tgpager -h /home/tgpager \
    # Created here so a named volume mounted on it inherits the owner. Docker
    # creates a missing mount point as root, which the unprivileged user then
    # cannot write the session file into.
    && mkdir -p /home/tgpager/data \
    && chown tgpager:tgpager /home/tgpager/data

WORKDIR /home/tgpager

# dockers_v2 places the target platform's artifacts under $TARGETPLATFORM/
COPY ${TARGETPLATFORM}/tgpager /usr/local/bin/tgpager

USER tgpager

VOLUME ["/home/tgpager/data"]

ENTRYPOINT ["tgpager"]
