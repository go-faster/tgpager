{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "audio": {
      "description": "Audio file played into the call, and the tone before speech.",
      "minLength": 1,
      "type": "string"
    },
    "call": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 3,
          "description": "How many times to place a call before giving up.",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "connect_timeout": {
          "default": "30s",
          "description": "How long an accepted call may take to negotiate media.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        },
        "retry_delay": {
          "default": "10s",
          "description": "Delay between call attempts.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        },
        "ring_timeout": {
          "default": "45s",
          "description": "How long an unanswered call keeps ringing.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "debug": {
      "default": false,
      "description": "Enable debug logging.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "peer": {
      "description": "Call target: @username, phone, t.me link, or id:\u003cuser-id\u003e[:\u003caccess-hash\u003e].",
      "minLength": 1,
      "type": "string"
    },
    "peer_cache": {
      "default": "peers.bolt",
      "description": "Path to the peer access hash cache. Account-scoped.",
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "telegram": {
      "additionalProperties": false,
      "properties": {
        "app_hash": {
          "description": "Telegram application hash.",
          "minLength": 1,
          "type": "string",
          "writeOnly": true
        },
        "app_id": {
          "description": "Telegram application ID.",
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "session": {
          "default": "session.json",
          "description": "Path to the session file. Holds credentials; keep it private.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "app_id",
        "app_hash"
      ],
      "type": "object"
    },
    "tts": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "default": "tts-cache",
              "description": "Directory holding synthesized audio, reused across resends.",
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "max_bytes": {
              "default": 268435456,
              "description": "Size the cache is trimmed to, dropping least recently used audio. Zero is unbounded.",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "ttl": {
              "default": "720h0m0s",
              "description": "How long unused audio is kept. Zero keeps it forever.",
              "format": "duration",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "provider": {
          "description": "Speech provider. Omit to page with the audio file alone.",
          "discriminator": {
            "propertyName": "type"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "api_key": {
                  "description": "Bearer token for the speech endpoint.",
                  "type": [
                    "string",
                    "null"
                  ],
                  "writeOnly": true
                },
                "base_url": {
                  "default": "https://api.openai.com/v1",
                  "description": "Base URL of the speech endpoint, without a trailing /audio/speech.",
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dialect": {
                  "default": "openai",
                  "description": "Where instructions go on the wire: top level for openai, nested for openrouter.",
                  "enum": [
                    "openai",
                    "openrouter"
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "format": {
                  "default": "mp3",
                  "description": "Audio format to request.",
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "instructions": {
                  "description": "How to deliver the line, for example \"Speak urgently and clearly\". Ignored by older models such as tts-1.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "model": {
                  "description": "Speech model, for example openai/gpt-4o-mini-tts.",
                  "minLength": 1,
                  "type": "string"
                },
                "speed": {
                  "description": "Playback multiplier. Unset leaves it to the provider.",
                  "maximum": 4,
                  "minimum": 0.25,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "type": {
                  "const": "openai",
                  "type": "string"
                },
                "voice": {
                  "default": "alloy",
                  "description": "Voice name, as understood by the model.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type",
                "model"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "description": "Arguments. {{text}} is replaced by the text to speak, otherwise it is written to stdin; {{output}} is replaced by a temporary file to write, otherwise audio is read from stdout.",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "name": {
                  "description": "Executable to run, for example piper.",
                  "minLength": 1,
                  "type": "string"
                },
                "output_format": {
                  "default": "wav",
                  "description": "Audio format the command produces.",
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "const": "command",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "name"
              ],
              "type": "object"
            }
          ]
        },
        "repeat": {
          "default": 3,
          "description": "How many times to play tone and speech, so a groggy callee gets a second chance.",
          "maximum": 10,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "template": {
          "description": "Go template rendered into the spoken sentence.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "default": "10s",
          "description": "How long to wait for synthesis before paging without speech.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "voice": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 3,
          "description": "How many times to try sending.",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "default": "off",
          "description": "When to leave the page in the chat as a voice message: never, only after every call attempt failed, on every page, or instead of calling.",
          "enum": [
            "off",
            "fallback",
            "always",
            "only"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "retry_delay": {
          "default": "2s",
          "description": "Delay between send attempts. A FLOOD_WAIT from Telegram wins over this when it asks for longer.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "default": "1m0s",
          "description": "How long to spend rendering and uploading before giving up.",
          "format": "duration",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "webhook": {
      "additionalProperties": false,
      "properties": {
        "addr": {
          "default": ":8080",
          "description": "HTTP listen address.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "queue_size": {
          "default": 100,
          "description": "How many pages may wait to be placed.",
          "maximum": 10000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "token": {
          "description": "Bearer token required from Alertmanager. Unset means unauthenticated.",
          "type": [
            "string",
            "null"
          ],
          "writeOnly": true
        }
      },
      "type": "object"
    }
  },
  "required": [
    "telegram",
    "peer",
    "audio"
  ],
  "title": "tgpager configuration",
  "type": "object"
}
